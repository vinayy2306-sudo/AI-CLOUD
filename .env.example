# Copy this file to .env and edit values as needed.
# Demo mode is on by default and uses clearly labelled sample results.
DEMO_MODE=true

# Used only when DEMO_MODE=false. Example: us-east-1
AWS_REGION=us-east-1

# Required when DEMO_MODE=false. Use an existing private S3 bucket.
S3_BUCKET_NAME=

# Rekognition label confidence threshold (0-100).
REKOGNITION_MIN_CONFIDENCE=70

# Optional Flask development setting. Keep false except while debugging locally.
FLASK_DEBUG=false
